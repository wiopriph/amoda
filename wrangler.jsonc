{
  // Воркер amoda: nitro-сборка cloudflare_module (npm run build)
  "name": "amoda",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amoda-content",
      "database_id": "8aeef530-93ff-4263-9947-2f2e9dc0e90e"
    }
  ],

  // Переменные и секреты ведутся в дашборде CF (Settings → Variables and Secrets),
  // деплой их не трогает благодаря keep_vars
  "keep_vars": true,

  "observability": {
    "enabled": true
  }
}
